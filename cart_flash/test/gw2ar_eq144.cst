IO_LOC "clk" 11;
IO_PORT "clk" IO_TYPE=LVCMOS33;
// UART según Litex/board/fpgbc_plat.py y su CST generado: TX=27, RX=28.
IO_LOC "TXD" 27;
IO_PORT "TXD" IO_TYPE=LVCMOS33;
IO_LOC "RXD" 28;
IO_PORT "RXD" IO_TYPE=LVCMOS33;
IO_LOC "link_oe" 29;
IO_PORT "link_oe" IO_TYPE=LVCMOS33;
IO_LOC "resetn" 120;
IO_PORT "resetn" IO_TYPE=LVCMOS33 PULL_MODE=UP;
// Cartucho: IO de FPGA a 3.3 V; VCCIO debe estar alimentado a 3.3 V.
// Control: contactos 2=CLK, 3=/WR, 4=/RD, 5=/CS.
IO_LOC "cart_clk" 60;
IO_PORT "cart_clk" IO_TYPE=LVCMOS33;
IO_LOC "cart_wr_n" 61;
IO_PORT "cart_wr_n" IO_TYPE=LVCMOS33;
IO_LOC "cart_rd_n" 62;
IO_PORT "cart_rd_n" IO_TYPE=LVCMOS33;
IO_LOC "cart_cs_n" 63;
IO_PORT "cart_cs_n" IO_TYPE=LVCMOS33;
IO_LOC "cart_ctrl_oe" 48;
IO_PORT "cart_ctrl_oe" IO_TYPE=LVCMOS33;
IO_LOC "cart_data_dir" 59;
IO_PORT "cart_data_dir" IO_TYPE=LVCMOS33;

